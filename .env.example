# App
NEXT_PUBLIC_APP_DOMAIN=yourdomain.vercel.app
NEXTAUTH_URL=https://yourdomain.vercel.app
NEXTAUTH_SECRET=<generate with: openssl rand -base64 32>

# Google OAuth (from Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (Supabase → Project Settings → Database → Connection string → URI)
DATABASE_URL=

# Vercel Blob (auto-populated when you connect a Blob store in the Vercel dashboard)
BLOB_READ_WRITE_TOKEN=

# --- Local Development Overrides ---
# Copy this file to .env.local and fill in your values.
# For local dev, set:
#   NEXT_PUBLIC_APP_DOMAIN=localhost:3000
#   NEXTAUTH_URL=http://localhost:3000
